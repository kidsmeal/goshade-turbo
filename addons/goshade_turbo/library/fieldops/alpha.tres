source_code_license = ""
kind_out = 0
inputs = Array[Dictionary]([{
"kind": 1,
"name": "color",
"label": "Color transparency",
"description": "Only the alpha channel is read."
}])
params = Array[Dictionary]([])
coord = false
samples_source = false
depends = Array[String]([])
code = "float alpha(vec4 color) {
	return color.a;
}
"
