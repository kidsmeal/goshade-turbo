[resource]
script = ExtResource("1")
id = "fieldops/alpha"
function = "alpha"
description = "reads a color's own alpha channel as a field (decision 12: the color-to-field conversion is luminance, so alpha needs its own reachable entry)"
source_math = "trivial vec4 alpha-channel read, no external source."
