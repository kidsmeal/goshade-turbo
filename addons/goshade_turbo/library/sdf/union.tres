script = ExtResource("1")
id = "sdf/union"
function = "sdf_union"
description = "boolean union of two signed distance fields, the lesser of the two"
source_math = "opUnion(d1, d2) = min(d1, d2). Inigo Quilez, \"2D distance functions\", https://iquilezles.org/articles/distfunctions2d/, section \"Combinations\"."
source_code_url = ""
source_code_license = ""
kind_out = 0
inputs = Array[Dictionary]([{
"kind": 0,
"name": "a"
}, {
"kind": 0,
"name": "b"
}])
params = Array[Dictionary]([])
coord = false
samples_source = false
depends = Array[String]([])
code = "float sdf_union(float a, float b) {
	return min(a, b);
}
"
