[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "sdf/ring"
function = "sdf_ring"
description = "signed distance to a ring (circle outline) of the given radius, positive outside, negative inside; thickness is the ring's half-width"
source_math = "annulus construction: abs(length(p) - radius) - thickness. Inigo Quilez, \"2D distance functions\", https://iquilezles.org/articles/distfunctions2d/, entry \"Circle - unsigned/annulus\" combinator."
source_code_url = ""
source_code_license = ""
kind_out = 0
inputs = Array[Dictionary]([])
params = Array[Dictionary]([{
"default": 0.3,
"max": 1.0,
"min": 0.05,
"name": "radius",
"type": "float",
"label": "Ring radius",
"description": "Center to the middle of the stroke."
}, {
"default": 0.05,
"max": 0.3,
"min": 0.005,
"name": "thickness",
"type": "float",
"label": "Ring half-width",
"description": "Half the stroke width."
}])
coord = true
samples_source = false
depends = Array[String]([])
code = "float sdf_ring(vec2 p, float radius, float thickness) {
	return abs(length(p) - radius) - thickness;
}
"
