[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "sdf/box"
function = "sdf_box"
description = "signed distance to an axis-aligned box, positive outside, negative inside"
source_math = "sdBox(p, b) = length(max(abs(p) - b, 0.0)) + min(max(d.x, d.y), 0.0). Inigo Quilez, \"2D distance functions\", https://iquilezles.org/articles/distfunctions2d/, entry \"Box\". b split into half_width/half_height (no vec2 param type in the manifest schema)."
source_code_url = ""
source_code_license = ""
kind_out = 0
inputs = Array[Dictionary]([])
params = Array[Dictionary]([{
"default": 0.3,
"max": 1.0,
"min": 0.05,
"name": "half_width",
"type": "float",
"label": "Half width",
"description": "The distance from the box center to its left or right edge."
}, {
"default": 0.3,
"max": 1.0,
"min": 0.05,
"name": "half_height",
"type": "float",
"label": "Half height",
"description": "The distance from the box center to its top or bottom edge."
}])
coord = true
samples_source = false
depends = Array[String]([])
code = "float sdf_box(vec2 p, float half_width, float half_height) {
	vec2 d = abs(p) - vec2(half_width, half_height);
	return length(max(d, 0.0)) + min(max(d.x, d.y), 0.0);
}
"
