[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "generative/value_noise"
function = "value_noise"
description = "bilinear-interpolated lattice noise, blockier and cheaper than simplex"
source_math = "value noise via bilinear interpolation over a hashed grid. The Book of Shaders, ch. 11 \"Value Noise\", https://thebookofshaders.com/11/"
source_code_url = ""
source_code_license = ""
kind_out = 0
inputs = Array[Dictionary]([])
params = Array[Dictionary]([])
coord = true
samples_source = false
depends = Array[String](["generative/hash"])
code = "float value_noise(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	float a = hash(i);
	float b = hash(i + vec2(1.0, 0.0));
	float c = hash(i + vec2(0.0, 1.0));
	float d = hash(i + vec2(1.0, 1.0));
	vec2 u = f * f * (3.0 - 2.0 * f);
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y);
}
"
