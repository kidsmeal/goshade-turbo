[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "generative/fbm"
function = "fbm"
description = "layered noise centered on 0.5, cloud like, octaves control detail"
source_math = "fractional Brownian motion: standard sum-of-octaves construction. See D. Ebert et al., \"Texturing & Modeling: A Procedural Approach\" (3rd ed., 2003), ch. 2. Octaves sum signed simplex noise (snoise remapped back to -1..1) and the sum is offset by 0.5 so the default settles around 0.5 instead of 0."
source_code_url = ""
source_code_license = ""
kind_out = 0
inputs = Array[Dictionary]([])
params = Array[Dictionary]([{
"default": 4,
"max": 8,
"min": 1,
"name": "octaves",
"type": "int",
"label": "Detail layers",
"description": "Noise layers stacked; more is finer detail and slower."
}, {
"default": 0.5,
"max": 0.8,
"min": 0.2,
"name": "gain",
"type": "float",
"label": "Fine detail strength",
"description": "Strength each finer layer keeps; 0.5 is standard."
}])
coord = true
samples_source = false
depends = Array[String](["generative/snoise"])
code = "float fbm(vec2 p, int octaves, float gain) {
	float sum = 0.0;
	float amp = 0.5;
	float freq = 1.0;
	for (int i = 0; i < octaves; i++) {
		sum += amp * (snoise(p * freq) * 2.0 - 1.0);
		freq *= 2.0;
		amp *= gain;
	}
	return sum + 0.5;
}
"
