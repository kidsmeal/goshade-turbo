[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "generative/snoise"
function = "snoise"
description = "2D simplex noise field, smoother and less axis-aligned than value noise"
source_math = "2D simplex noise construction: Ken Perlin (2001). Skew/unskew derivation per Stefan Gustavson, \"Simplex noise demystified\" (2005). Gradients here come from an angle derived through this library's own hash() rather than a permutation table; that substitution is an implementation choice, not copied from any specific source."
source_code_url = ""
source_code_license = ""
kind_out = 0
inputs = Array[Dictionary]([])
params = Array[Dictionary]([])
coord = true
samples_source = false
depends = Array[String](["generative/hash"])
code = "vec2 gst_grad2(vec2 i) {
	float a = hash(i) * 6.28318530718;
	return vec2(cos(a), sin(a));
}

float snoise(vec2 p) {
	const float k1 = 0.36602540378; // (sqrt(3.0) - 1.0) / 2.0
	const float k2 = 0.21132486541; // (3.0 - sqrt(3.0)) / 6.0
	vec2 i = floor(p + (p.x + p.y) * k1);
	vec2 a = p - i + (i.x + i.y) * k2;
	vec2 o = a.x > a.y ? vec2(1.0, 0.0) : vec2(0.0, 1.0);
	vec2 b = a - o + k2;
	vec2 c = a - 1.0 + 2.0 * k2;
	vec3 h = max(0.5 - vec3(dot(a, a), dot(b, b), dot(c, c)), 0.0);
	vec3 n = h * h * h * h * vec3(dot(a, gst_grad2(i)), dot(b, gst_grad2(i + o)), dot(c, gst_grad2(i + vec2(1.0))));
	return dot(n, vec3(70.0));
}
"
