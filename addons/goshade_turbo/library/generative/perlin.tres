[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "generative/perlin"
function = "perlin"
description = "classic gradient noise on a square lattice, softer than value noise"
source_math = "classic 2D gradient (Perlin) noise: Ken Perlin, \"An Image Synthesizer\", SIGGRAPH 1985. Gradients here come from an angle derived through this library's own hash(), not a permutation table; that substitution is an implementation choice, not copied from any specific source."
source_code_url = ""
source_code_license = ""
kind_out = 0
inputs = Array[Dictionary]([])
params = Array[Dictionary]([])
coord = true
samples_source = false
depends = Array[String](["generative/hash"])
code = "vec2 gst_perlin_grad(vec2 i) {
	float a = hash(i) * 6.28318530718;
	return vec2(cos(a), sin(a));
}

float perlin(vec2 p) {
	vec2 i = floor(p);
	vec2 f = fract(p);
	vec2 u = f * f * (3.0 - 2.0 * f);
	float a = dot(gst_perlin_grad(i), f);
	float b = dot(gst_perlin_grad(i + vec2(1.0, 0.0)), f - vec2(1.0, 0.0));
	float c = dot(gst_perlin_grad(i + vec2(0.0, 1.0)), f - vec2(0.0, 1.0));
	float d = dot(gst_perlin_grad(i + vec2(1.0, 1.0)), f - vec2(1.0, 1.0));
	return mix(mix(a, b, u.x), mix(c, d, u.x), u.y) * 0.5 + 0.5;
}
"
