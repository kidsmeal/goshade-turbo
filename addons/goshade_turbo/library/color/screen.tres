[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "color/screen"
function = "blend_screen"
description = "screen blend of two colors, opacity via t (function is blend_screen, not screen, to keep the name clear of source/screen, decision 14: opacity is the layer's t slider)"
source_math = "screen blend mode, W3C Compositing and Blending Level 1."
source_code_url = ""
source_code_license = ""
kind_out = 1
inputs = Array[Dictionary]([{
"kind": 1,
"name": "a",
"label": "Base color",
"description": "The starting color that will be lightened by the screen blend."
}, {
"kind": 1,
"name": "b",
"label": "Screen color",
"description": "The color screened over the base; lighter channels have more effect."
}])
params = Array[Dictionary]([{
"default": 1.0,
"max": 1.0,
"min": 0.0,
"name": "t",
"type": "float",
"label": "Screen strength",
"description": "Blends from the unchanged base at zero to the full screen result at one."
}])
coord = false
samples_source = false
depends = Array[String]([])
code = "vec4 blend_screen(vec4 a, vec4 b, float t) {
	vec4 blended = vec4(1.0 - (1.0 - a.rgb) * (1.0 - b.rgb), a.a);
	return mix(a, blended, t);
}
"
