[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "color/hue_shift"
function = "hue_shift"
description = "rotates hue by a signed 0..1 turn"
source_math = "hue rotation via an RGB-to-YIQ rotation matrix, standard technique (e.g. https://beesbuzz.biz/code/hsv_color_transforms.php)."
source_code_url = ""
source_code_license = ""
kind_out = 1
inputs = Array[Dictionary]([{
"kind": 1,
"name": "color",
"label": "Color to shift",
"description": "The color whose hue will be rotated while brightness stays similar."
}])
params = Array[Dictionary]([{
"default": 0.0,
"max": 1.0,
"min": -1.0,
"name": "shift",
"type": "float",
"label": "Hue rotation",
"description": "Rotates the hue around the color wheel; one unit is one full turn."
}])
coord = false
samples_source = false
depends = Array[String]([])
code = "vec4 hue_shift(vec4 color, float shift) {
	mat3 rgb2yiq = mat3(vec3(0.299, 0.596, 0.211), vec3(0.587, -0.274, -0.523), vec3(0.114, -0.322, 0.312));
	mat3 yiq2rgb = mat3(vec3(1.0, 1.0, 1.0), vec3(0.956, -0.272, -1.106), vec3(0.621, -0.647, 1.703));
	vec3 yiq = rgb2yiq * color.rgb;
	float angle = shift * 6.28318530718;
	float s = sin(angle);
	float c = cos(angle);
	vec2 rotated_iq = mat2(vec2(c, s), vec2(-s, c)) * yiq.yz;
	vec3 rgb = yiq2rgb * vec3(yiq.x, rotated_iq);
	return vec4(clamp(rgb, 0.0, 1.0), color.a);
}
"
