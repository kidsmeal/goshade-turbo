[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "filter/dither"
function = "dither"
description = "ordered dither before quantization of a texture or screen source"
source_math = "ordered dithering via a per-pixel hash threshold before quantization, standard shader dither construction (threshold from this library's hash() of the integer pixel coordinate FRAGCOORD.xy, so the pattern is per pixel and independent of UV scale)."
source_code_url = ""
source_code_license = ""
kind_out = 1
inputs = Array[Dictionary]([{
"kind": 1,
"name": "source",
"label": "Image to dither",
"description": "Alpha passes through unchanged; only rgb gets the per-pixel dither offset before quantization."
}])
params = Array[Dictionary]([{
"default": 4,
"max": 16,
"min": 2,
"name": "levels",
"type": "int",
"label": "Color levels",
"description": "Brightness steps per channel; 2 is two-tone."
}])
coord = false
samples_source = true
depends = Array[String](["generative/hash"])
code = "vec4 c = GST_SAMPLE(GST_UV);
float bayer = hash(floor(FRAGCOORD.xy));
float steps = float(max(GST_PARAM(levels) - 1, 1));
vec3 stepped = floor(c.rgb * steps + bayer) / steps;
GST_OUT = vec4(stepped, c.a);
"
