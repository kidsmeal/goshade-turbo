[gd_resource type="Resource" script_class="GSTManifestEntry" format=3]

[ext_resource type="Script" path="res://addons/goshade_turbo/model/gst_manifest_entry.gd" id="1"]

[resource]
script = ExtResource("1")
id = "filter/outline"
function = "outline"
description = "alpha-edge outline mask, inline filter body template (decision 21, B6, docs/PLAN.md Blocker B10)"
source_math = "alpha edge detection via 4-neighbor max difference, standard sprite outline technique."
source_code_url = ""
source_code_license = ""
kind_out = 1
inputs = Array[Dictionary]([{
"kind": 1,
"name": "source",
"label": "Image silhouette",
"description": "Outline follows the alpha edge."
}])
params = Array[Dictionary]([{
"default": 0.003,
"max": 0.02,
"min": 0.0005,
"name": "thickness",
"type": "float",
"label": "Outline thickness",
"description": "Search distance around each pixel, texture space."
}, {
"default": 0.1,
"max": 1.0,
"min": 0.0,
"name": "threshold",
"type": "float",
"label": "Edge threshold",
"description": "Alpha difference needed before a pixel counts as edge; 0 catches everything."
}])
coord = false
samples_source = true
depends = Array[String]([])
code = "float center_a = GST_SAMPLE(GST_UV).a;
float neighbor_a = max(
	max(GST_SAMPLE(GST_UV + vec2(GST_PARAM(thickness), 0.0)).a, GST_SAMPLE(GST_UV - vec2(GST_PARAM(thickness), 0.0)).a),
	max(GST_SAMPLE(GST_UV + vec2(0.0, GST_PARAM(thickness))).a, GST_SAMPLE(GST_UV - vec2(0.0, GST_PARAM(thickness))).a)
);
float edge = step(GST_PARAM(threshold), neighbor_a - center_a);
GST_OUT = vec4(vec3(edge), edge);
"
